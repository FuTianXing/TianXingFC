#!/bin/sh
# 元相子理论工作区 pre-commit 钩子
# 启用：git config core.hooksPath .githooks
# 现有两道检查，任一不过即拒绝提交：
#   一、.md 控制字符
#   二、README 编号新增撞号
python "$(git rev-parse --show-toplevel)/.githooks/check_md_control.py" || exit 1
python "$(git rev-parse --show-toplevel)/.githooks/check_readme_numbers.py" || exit 1
exit 0
